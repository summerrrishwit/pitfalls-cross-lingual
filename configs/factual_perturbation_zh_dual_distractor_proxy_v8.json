{
  "extends": "configs/factual_perturbation_zh_five_model_v7.json",
  "config_version": "factual-perturbation-zh-dual-distractor-proxy-v8",
  "inputs": {
    "allowed_splits": [
      "development"
    ]
  },
  "model_roles": {
    "perturbation_generation": {
      "manipulation_family": "explicit_false_assertion_v1",
      "candidates_per_distractor": 1,
      "strength_levels": [],
      "matched_neutral": true,
      "target_distractors_per_source": 2
    },
    "perturbation_validation": {
      "hard_gate": false,
      "required_checks": [
        "explicit_false_assertion",
        "designated_distractor_asserted",
        "single_false_claim",
        "relation_preserved",
        "bilingual_equivalent",
        "naturalness",
        "no_prompt_duplication",
        "neutral_truthful",
        "neutral_no_answer_or_distractor_cue",
        "neutral_matched"
      ]
    },
    "simulation": {
      "endpoint": "multi_option",
      "max_options": 3,
      "neutral_context_mode": "matched_per_candidate",
      "require_all_models_completed": true,
      "models": [
        {
          "model": "qwen3.6-27b",
          "provider_profile": "aliyun",
          "timeout_seconds": 30,
          "max_retries": 1
        },
        {
          "model": "bailian/deepseek-v3.2",
          "provider_profile": "deepseek",
          "timeout_seconds": 30,
          "max_retries": 1
        },
        {
          "model": "gemini-3.7-flash",
          "provider_profile": "test_gateway",
          "timeout_seconds": 30,
          "max_retries": 1
        },
        {
          "model": "gemma3:12b",
          "provider_profile": "ollama_local",
          "max_output_tokens": 64,
          "timeout_seconds": 900,
          "max_retries": 1
        },
        {
          "model": "llama3.1:8b",
          "provider_profile": "ollama_local",
          "max_output_tokens": 64,
          "timeout_seconds": 900,
          "max_retries": 1
        }
      ]
    }
  }
}
