{
  "extends": "configs/factual_perturbation_zh_streamlined_v5.json",
  "config_version": "factual-perturbation-zh-qwen3-vllm-v1",
  "provider_profiles": {
    "qwen3_vllm": {
      "protocol": "openai_compatible",
      "authentication": "api_key",
      "api_key_env": "QWEN3_VLLM_API_KEY",
      "base_url_env": "QWEN3_VLLM_BASE_URL",
      "json_mode": true
    }
  },
  "model_roles": {
    "simulation": {
      "models": [
        {
          "model": "qwen3-8b",
          "provider_profile": "qwen3_vllm",
          "max_output_tokens": 64,
          "timeout_seconds": 180,
          "max_retries": 1
        }
      ],
      "temperature": 0.0,
      "max_output_tokens": 64,
      "batch_by_model": true
    }
  },
  "execution": {
    "max_workers": 8,
    "provider_max_concurrency": {
      "qwen3_vllm": 8
    },
    "timeout_seconds": 180
  }
}
