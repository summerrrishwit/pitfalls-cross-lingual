  "outputs": {
    "root": "data_processed/factual_perturbation/zh-mvp-v1",
    "translation": "translations.jsonl",
    "verified_distractors": "verified_distractors.jsonl",
    "perturbations": "perturbations.jsonl",
    "simulation": "simulation_results.jsonl",
    "holdout": "holdout_results.jsonl",
    "manifest": "run_manifest.json"
