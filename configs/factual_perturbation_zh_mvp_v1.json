    "perturbation_generation": {
      "primary": {
        "model": "gpt-5.6-sol",
        "provider_profile": "openai",
        "reasoning_effort": "medium",
        "max_output_tokens": 768
      },
      "candidates_per_distractor": 2
    },
    "perturbation_validation": {
      "primary_judge": {
        "model": "qwen3.8-max",
        "provider_profile": "aliyun",
        "temperature": 0.0,
        "max_output_tokens": 1024
      },
      "uncertain_or_invalid_action": "reject",
      "required_checks": [
        "ground_truth_preserved",
        "no_explicit_falsehood",
        "relation_preserved",
        "bilingual_equivalent",
        "naturalness",
        "target_distractor_salience",
        "no_prompt_duplication"
      ]
    },
    "simulation": {
      "variants": [
        "original",
        "neutral",
        "targeted"
      ],
      "baseline_reuse_key": [
        "source_id",
        "distractor_id",
        "model",
        "language",
        "variant"
      ],
      "models": [
        {
          "model": "qwen3.7-plus",
          "provider_profile": "aliyun"
        },
        {
          "model": "bailian/deepseek-v4-flash-0731",
          "provider_profile": "deepseek"
        },
        {
          "model": "hy4-preview",
          "provider_profile": "test_gateway",
          "max_output_tokens": 1024
        },
        {
          "model": "gemini-3.7-flash",
          "provider_profile": "test_gateway"
        }
      ],
      "temperature": 0.0,
      "max_output_tokens": 256,
      "require_all_models_completed": true,
      "logprobs_optional": true
