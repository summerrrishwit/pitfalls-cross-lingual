    "test_gateway": {
      "protocol": "openai_compatible",
      "api_key_env": "TEST_API_KEY",
      "base_url_env": "TEST_BASE_URL",
      "declared_default_model_env": "TEST_MODEL"
    },
    "aliyun": {
      "protocol": "openai_compatible",
      "api_key_env": "AILYUN_API_KEY",
      "base_url_env": "AILYUN_BASE_URL",
      "chat_path_env": "AILYUN_CHAT_PATH",
      "declared_default_model_env": "AILYUN_MODEL"
    },
    "deepseek": {
      "protocol": "openai_compatible",
      "api_key_env": "DEEPSEEK_API_KEY",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "declared_default_model_env": "DEEPSEEK_MODEL"
    },
    "claude_cc": {
      "protocol": "anthropic",
      "api_key_env": "CC_API_KEY",
      "base_url_env": "CC_BASE_URL",
      "declared_default_model_env": "CC_MODEL_ID"
    }
  },
  "model_roles": {
    "translation": {
      "primary": {
        "model": "qwen3.8-max",
        "provider_profile": "aliyun",
        "temperature": 0.0,
        "max_output_tokens": 512
      },
      "reviewer": {
        "model": "gpt-5.5",
        "provider_profile": "openai",
        "reasoning_effort": "low",
        "max_output_tokens": 1024
      },
      "review_mode": "all_in_pilot_then_failures_and_sample"
    },
    "distractor_validation": {
      "primary_judge": {
        "model": "qwen3.8-max",
        "provider_profile": "aliyun",
        "temperature": 0.0,
        "max_output_tokens": 1024
      },
      "uncertain_or_invalid_action": "reject"
