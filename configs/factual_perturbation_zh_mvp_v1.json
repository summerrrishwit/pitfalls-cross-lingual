  "preflight": {
    "run_id": "preflight-10-v1",
    "base_triple_limit": 10,
    "minimum_translation_acceptance": 0.5,
    "require_at_least_one_verified_distractor": true,
    "require_at_least_one_verified_perturbation": true,
    "require_all_four_simulation_models": true,
    "currency_cost_gate": null,
