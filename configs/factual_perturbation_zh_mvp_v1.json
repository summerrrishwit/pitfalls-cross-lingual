    "non_simulation_holdout": {
      "models": [
        {
          "model": "claude-opus-4-8",
          "provider_profile": "claude_cc"
        }
      ],
      "run_only_after_candidate_freeze": true,
      "holdout_level": "model_and_family"
    },
    "excluded_from_this_run": [
      {
        "model_family": "SenseNova",
        "reason": "user_requested_no_sensenova_calls"
      }
    ]
  },
  "pilot": {
    "base_triple_limit": 100,
    "seed": 20260908,
    "stratify_by": [
      "source_dataset",
      "prompt_quality_tier",
      "answer_type"
    ],
    "max_distractors_per_triple": 2,
    "beam_width": 4,
    "max_depth": 2,
    "max_good_per_triple": 2
  },
  "scoring": {
    "score_type": "paper",
    "gamma": 2.0,
    "english_perturbed_accuracy_required": 1.0,
    "record_distractor_hit": true,
    "record_probability_or_rank_shift_when_available": true,
    "badcase_types": [
      "induced",
      "amplified"
    ]
  },
  "execution": {
    "resume": true,
    "max_workers": 4,
    "provider_max_concurrency": {
      "openai": 2,
      "aliyun": 2,
      "deepseek": 2,
      "test_gateway": 1,
      "claude_cc": 1
    },
    "max_retries": 3,
    "timeout_seconds": 180,
    "store_raw_responses": true,
    "store_prompt_and_model_versions": true,
    "credentials_in_artifacts": false
