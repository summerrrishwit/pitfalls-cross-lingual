# Leave these blank when direct internet access is available.
HTTP_PROXY=
HTTPS_PROXY=

OPENAI_API_KEY=

DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=

YI_BASE_URL=https://api.lingyiwanwu.com/v1/
YI_API_KEY=

# Alibaba Cloud Model Studio / Bailian (OpenAI-compatible)
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TIMEOUT_SECONDS=120
BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=
ANSWER_EXTRACT_MODEL=qwen3.7-plus

ANTHROPIC_API_KEY=

# Keep Hugging Face cache/model downloads off /root/autodl-tmp.
HF_HOME=/root/.cache/huggingface
HF_HUB_CACHE=/root/.cache/huggingface/hub
QWEN25_7B_MODEL_DIR=/root/hf_models/Qwen2.5-7B
