{"source_id": "raw_mmlu_000277", "source_dataset": "mmlu", "source_subset": "professional_law", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 277, "source_question": "Two executives from a company in China agreed to steal trade secrets of a pharmaceutical company in the United States. They arranged a meeting to purchase the secrets from an unscrupulous employee of the pharmaceutical company in the company's New York office. The person selling the \"secrets\" was an undercover FBI agent. The envelope that he held, with the word \"Confidential\" typed on the outside of it, contained various recipes and gardening tips. When the defendants turned over the money, they were arrested on federal charges of conspiracy to steal trade secrets. The defendants moved to dismiss the indictment, claiming that it was legally impossible to steal trade secrets when in fact there were no trade secrets in the envelope. Will the federal district court likely grant the motion to dismiss?", "source_choices": ["Yes, legal impossibility is a defense to criminal conspiracy.", "Yes, factual impossibility is a defense to criminal conspiracy.", "No, legal impossibility is not a defense to the crime of conspiracy.", "No, the defendants were guilty of conspiracy as a matter of law."], "source_answer": "No, legal impossibility is not a defense to the crime of conspiracy.", "candidate_id": "raw_mmlu_000277", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 277, "record": {"question": "Two executives from a company in China agreed to steal trade secrets of a pharmaceutical company in the United States. They arranged a meeting to purchase the secrets from an unscrupulous employee of the pharmaceutical company in the company's New York office. The person selling the \"secrets\" was an undercover FBI agent. The envelope that he held, with the word \"Confidential\" typed on the outside of it, contained various recipes and gardening tips. When the defendants turned over the money, they were arrested on federal charges of conspiracy to steal trade secrets. The defendants moved to dismiss the indictment, claiming that it was legally impossible to steal trade secrets when in fact there were no trade secrets in the envelope. Will the federal district court likely grant the motion to dismiss?", "choices": ["Yes, legal impossibility is a defense to criminal conspiracy.", "Yes, factual impossibility is a defense to criminal conspiracy.", "No, legal impossibility is not a defense to the crime of conspiracy.", "No, the defendants were guilty of conspiracy as a matter of law."], "answer": "No, legal impossibility is not a defense to the crime of conspiracy.", "source": "MMLU", "subject": "professional_law"}}, "created_at": "2026-08-09T14:20:44.060882+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"scenario_classification\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "scenario_classification", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "scenario_classification", "subject": n