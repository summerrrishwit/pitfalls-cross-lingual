{"source_id": "raw_sciq_000240", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 240, "source_question": "Matrix is the term for the fluid-filled interior of what structure, where most of the cell’s atp is made?", "source_choices": ["nucleus", "Golgi apparatus", "enzyme", "mitochondria"], "source_answer": "mitochondria", "candidate_id": "raw_sciq_000240", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 240, "record": {"question": "Matrix is the term for the fluid-filled interior of what structure, where most of the cell’s atp is made?", "choices": ["nucleus", "Golgi apparatus", "enzyme", "mitochondria"], "answer": "mitochondria", "source": "sciq"}}, "created_at": "2026-08-10T03:10:20.889143+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-plus-2026-05-26", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"fluid-filled interior where most of the cell’s ATP is made\",\n  \"subject_type\": \"cellular structure component\",\n  \"relation_raw\": \"term for definition\",\n  \"answer\": \"mitochondria\",\n  \"answer_type\": \"organelle\",\n  \"canonical_fact\": \"Matrix is the term for the fluid-filled interior of mitochondria, where most of the cell’s ATP is made.\",\n  \"extraction_confidence\": 1.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "fluid-filled interior where most of the cell’s ATP is made", "subject_type": "cellular structure component", "relation_raw": "term for d