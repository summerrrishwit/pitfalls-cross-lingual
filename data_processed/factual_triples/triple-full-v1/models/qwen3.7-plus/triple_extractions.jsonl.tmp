{"source_id": "raw_mmlu_000010", "source_dataset": "mmlu", "source_subset": "professional_law", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 10, "source_question": "The head coach of the local high school football team was also employed as a physical education teacher at the high school. It was a late autunm afternoon, and the football team was practicing for its upcoming game against its archrival. While the team was practicing, the skies darkened as a storm approached. Minutes later, it began to rain heavily. Even though the storm intensified, the coach did not stop the practice because he had no reason to believe the storm presented a danger to his players. Suddenly, a bolt of lightning struck and killed the team's star player. This jurisdiction has abolished governmental immunity, and a school board may be sued as a private entity. If the player's parents bring a wrongful death action against the coach and the high school board, will they prevail?", "source_choices": ["Yes, because the player was injured while engaged in a school activity.", "Yes, because under the circumstances the coach would be strictly liable.", "No, because the coach was not negligent by continuing the practice.", "No, because lightning is an act of God."], "source_answer": "No, because the coach was not negligent by continuing the practice.", "candidate_id": "raw_mmlu_000010", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 10, "record": {"question": "The head coach of the local high school football team was also employed as a physical education teacher at the high school. It was a late autunm afternoon, and the football team was practicing for its upcoming game against its archrival. While the team was practicing, the skies darkened as a storm approached. Minutes later, it began to rain heavily. Even though the storm intensified, the coach did not stop the practice because he had no reason to believe the storm presented a danger to his players. Suddenly, a bolt of lightning struck and killed the team's star player. This jurisdiction has abolished governmental immunity, and a school board may be sued as a private entity. If the player's parents bring a wrongful death action against the coach and the high school board, will they prevail?", "choices": ["Yes, because the player was injured while engaged in a school activity.", "Yes, because under the circumstances the coach would be strictly liable.", "No, because the coach was not negligent by continuing the practice.", "No, because lightning is an act of God."], "answer": "No, because the coach was not negligent by continuing the practice.", "source": "MMLU", "subject": "professional_law"}}, "created_at": "2026-08-09T07:02:48.598596+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"multi_step_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "multi_step_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "multi_step_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canon