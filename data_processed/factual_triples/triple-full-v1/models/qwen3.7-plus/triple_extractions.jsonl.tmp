{"source_id": "raw_commonsense_qa_000216", "source_dataset": "commonsense_qa", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "source_original_index": 216, "source_question": "James constructed a playroom for his children.   His place was small, so he put it in an unattached what?", "source_choices": ["preschool", "indoor games", "nursery school", "building", "big house"], "source_answer": "building", "candidate_id": "raw_commonsense_qa_000216", "source_snapshot": {"dataset": "commonsense_qa", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "original_index": 216, "record": {"question": "James constructed a playroom for his children.   His place was small, so he put it in an unattached what?", "choices": ["preschool", "indoor games", "nursery school", "building", "big house"], "answer": "building", "source": "commonsense_qa"}}, "created_at": "2026-08-09T14:20:20.249950+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"scenario_classification\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "scenario_classification", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extract