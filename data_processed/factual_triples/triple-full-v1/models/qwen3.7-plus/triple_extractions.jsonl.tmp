{"source_id": "raw_commonsense_qa_000235", "source_dataset": "commonsense_qa", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "source_original_index": 235, "source_question": "What does a policeman patrol?", "source_choices": ["street", "coffee", "freeway", "donut shop", "police station"], "source_answer": "street", "candidate_id": "raw_commonsense_qa_000235", "source_snapshot": {"dataset": "commonsense_qa", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "original_index": 235, "record": {"question": "What does a policeman patrol?", "choices": ["street", "coffee", "freeway", "donut shop", "police station"], "answer": "street", "source": "commonsense_qa"}}, "created_at": "2026-08-09T14:20:41.721861+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"non_unique_answer\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "non_unique_answer", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "non_unique_answer", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0}, "validation_errors": [], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:08:29.492142+00:00", "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': '预扣费额度失败, 用户剩余额度: ¥0.009282, 需要预扣费额度: ¥0.009926 (request id: 202608090708283539065708268d9d6DGexSV8f)', 'type': 'new_api_error', 'param': '', 'code': 'insufficient_user_quota'}}"}, "validation_errors": ["extraction_request_failed"]}]}
{"source_id": "raw_mmlu_000252", "source_dataset": "mmlu", "source_subset": "professional_law", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 252, "source_question": "A motorist who was injured in an accident sued the negligent other driver for his damages. The defense medical expert did an independent medical examination and reviewed all medical records. The expert testified that the accident did not cause the injuries because the medical records proved a long history of prior treatment for the same symptoms. The jury returned a verdict for the plaintiff but awarded only $10 in damages. On post-trial motions, the plaintiff argued that the expert's testimony was inadmissible hearsay because he based it on prior treating physicians' records, and the prior doctors were not available for cross-examination. Under the Federal Rules of Evidence, what is the correct ruling?", "source_choices": ["Testimony regarding the plaintiff's condition prior to the accident is irrelevant and the testimony is inadmissible.", "The Federal Rules of Evidence allow the admission of hearsay statements that were made for the purpose of medical diagnosis or treatment.", "Medical testimony that is relevant to the issues can never by excluded from the defendant's case because it is always reliable.", "The testimony is inadmissible hearsay because there was a constitutional right under these facts to cross-examine the doctors who wrote the prior records."], "source_answer": "The Federal Rules of Evidence allow the admission of hearsay statements that were made for the purpose of medical diagnosis or treatment.", "candidate_id": "raw_mmlu_000252", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 252, "record": {"question": "A motorist who was injured in an accident sued the negligent other driver for his damages. The defense medical expert did an independent medical examination and reviewed all medical records. The expert testified that the accident did not cause the injuries because the medical records proved a long history of prior treatment for the same symptoms. The jury returned a verdict for the plaintiff but awarded only $10 in damages. On post-trial motions, the plaintiff argued that the expert's testimony was inadmissible hearsay because he based it on prior treating physicians' records, and the prior doctors were not available for cross-examination. Under the Federal Rules of Evidence, what is the correct ruling?", "choices": ["Testimony regarding the plaintiff's condition prior to the accident is irrelevant and the testimony is inadmissible.", "The Federal Rules of Evidence allow the admission of hearsay statements that were made for the purpose of medical diagnosis or treatment.", "Medical testimony that is relevant to the issues can never by excluded from the defendant's case because it is always reliable.", "The testimony is inadmissible hearsay because there was a constitutional right under these facts to cross-examine the doctors who wrote the prior records."], "answer": "The Federal Rules of Evidence allow the admission of hearsay statements that were made for the purpose of medical diagnosis or treatment.", "source": "MMLU", "subject": "professional_law"}}, "created_at": "2026-08-09T14:20:41.812407+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"multi_step_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt