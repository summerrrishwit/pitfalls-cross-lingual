{"source_id": "raw_mmlu_000158", "source_dataset": "mmlu", "source_subset": "security_studies", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 158, "source_question": "When may an issue fail to become securitized?", "source_choices": ["When the general public is not convinced of the legitimacy of the proposed threat.", "When, following the discursive element of the process, extraordinary measures are not implemented.", "When the securitizing actor is not granted the special right to implement extraordinary measure.", "When the audience are convinced via the speech act or the securitizing actor but fail to grant that actor the special rights requested in order to address the proposed threat."], "source_answer": "When the securitizing actor is not granted the special right to implement extraordinary measure.", "candidate_id": "raw_mmlu_000158", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 158, "record": {"question": "When may an issue fail to become securitized?", "choices": ["When the general public is not convinced of the legitimacy of the proposed threat.", "When, following the discursive element of the process, extraordinary measures are not implemented.", "When the securitizing actor is not granted the special right to implement extraordinary measure.", "When the audience are convinced via the speech act or the securitizing actor but fail to grant that actor the special rights requested in order to address the proposed threat."], "answer": "When the securitizing actor is not granted the special right to implement extraordinary measure.", "source": "MMLU", "subject": "security_studies"}}, "created_at": "2026-08-09T14:21:16.080444+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature