{"source_id": "raw_commonsense_qa_000205", "source_dataset": "commonsense_qa", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "source_original_index": 205, "source_question": "John can't find any legal alternatives to what he's looking for.  It's very illegal, exacerbated by the fact that he's too young to travel out of the country to get it.  Where will he have to get it from?", "source_choices": ["rules", "white market", "banned", "underage", "black market"], "source_answer": "black market", "candidate_id": "raw_commonsense_qa_000205", "source_snapshot": {"dataset": "commonsense_qa", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "original_index": 205, "record": {"question": "John can't find any legal alternatives to what he's looking for.  It's very illegal, exacerbated by the fact that he's too young to travel out of the country to get it.  Where will he have to get it from?", "choices": ["rules", "white market", "banned", "underage", "black market"], "answer": "black market", "source": "commonsense_qa"}}, "created_at": "2026-08-09T07:05:40.633121+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"typical_action_or_location\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "typical_action_or_location", "subject": null, "subject_type": null, "relation_raw": null, "answer": nu