{"source_id": "raw_commonsense_qa_000234", "source_dataset": "commonsense_qa", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "source_original_index": 234, "source_question": "The person was exposed as a liar, so what happened as a result?", "source_choices": ["prepare to go", "catch cold", "hunt for food", "they shivered", "feel humiliated"], "source_answer": "feel humiliated", "candidate_id": "raw_commonsense_qa_000234", "source_snapshot": {"dataset": "commonsense_qa", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/commonsense_qa.json", "original_index": 234, "record": {"question": "The person was exposed as a liar, so what happened as a result?", "choices": ["prepare to go", "catch cold", "hunt for food", "they shivered", "feel humiliated"], "answer": "feel humiliated", "source": "commonsense_qa"}}, "created_at": "2026-08-09T14:20:40.686707+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"causal_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "causal_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "causal_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0}, "validation_errors": [], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:08:28.978571+00:00", "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': '预扣费额度失败, 用户剩余额度: ¥0.009282, 需要预扣费额度: ¥0.009954 (request id: 202608090708278333808938268d9d6AXSRz0NF)', 'type': 'new_api_error', 'param': '', 'code': 'insufficient_user_quota'}}"}, "validation_errors": ["extraction_request_failed"]}]}
{"source_id": "raw_mmlu_000250", "source_dataset": "mmlu", "source_subset": "professional_law", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 250, "source_question": "Needing a new supply of basketballs for the upcoming season, a basketball coach placed an order with a sporting goods store to purchase 25 regulation basketballs. Since the season was scheduled to begin on November 1, the coach stated that he needed the basketballs delivered no later than October 15. The sporting goods store said it would deliver the basketballs by that date. On October 10, one of the sporting goods store's employees was moving items in the warehouse and accidentally destroyed a container of basketballs. As a result, the owner of the sporting goods store telephoned the coach on October 11 and said, \"We had an accident in our warehouse yesterday, and as a result we do not have enough basketballs to fill all of our orders. Therefore, I won't be able to deliver your basketballs on October 15. However, I have contacted our supplier to see if they can rush a delivery of basketballs to us. Although I can't promise it, I should be able to deliver the basketballs you ordered by October 20. \" The coach replied, \"No problem. I think I'll be able to get by until then. \" When the coach failed to receive the basketballs on October 20, he sent the following e-mail to the sporting goods store:\"I must have the basketballs no later than October 23. \" The e-mail was received and read the same day by the owner of the sporting goods store. If the sporting goods store fails to deliver the basketballs to the coach on October 23, will the coach be entitled to cancel the contract?", "source_choices": ["Yes, provided both parties are viewed as being merchants.", "Yes, provided that the three-day notice afforded the sporting goods store a reasonable time in which to perform.", "No, because the coach's October 11 statement effectuated a waiver of any condition of timely delivery.", "No, because the sporting goods store, by its October 11 statement, did not promise to deliver the basketballs by October 20."], "source_answer": "Yes, provided that the three-day notice afforded the sporting goods store a reasonable time in which to perform.", "candidate_id": "raw_mmlu_000250", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 250, "record": {"question": "Needing a new supply of basketballs for the upcoming season, a basketball coach placed an order with a sporting goods store to purchase 25 regulation basketballs. Since the season was scheduled to begin on November 1, the coach stated that he needed the basketballs delivered no later than October 15. The sporting goods store said it would deliver the basketballs by that date. On October 10, one of the sporting goods store's employees was moving items in the warehouse and accidentally destroyed a container of basketballs. As a result, the owner of the sporting goods store telephoned the coach on October 11 and said, \"We had an accident in our warehouse yesterday, and as a result we do not have enough basketballs to fill all of our orders. Therefore, I won't be able to deliver your basketballs on October 15. However, I have contacted our supplier to see if they can rush a delivery of basketballs to us. Although I can't promise it, I should be able to deliver the basketballs you ordered by October 20. \" The coach replied, \"No problem. I think I'll be able to get by until then. \" When the coach failed to receive the basketballs on October 20, he sent the following e-mail to the sporting goods store:\"I must have the basketballs no later than October 23. \" The e-mail was received and read the same day by the owner of the sporting goods store. If the sporting goods store fails to deliver the basketballs to the coach on October 23, will the coach be entitled to cancel the contract?", "choices": ["Yes, provided both parties are viewed as being merchants.", "Yes, provided that the three-day notice afforded the sporting goods store a reasonable time in which to perform.", "No, because the coach's October 11 statement effectuated a waiver of any condition of timely delivery.", "No, because the sporting goods store, by its October 11 statement, did not promise to deliver the basketballs by October 20."], "answer": "Yes, provided that the three-day notice afforded the sporting goods store a reasonable time in which to perform.", "source": "MMLU", "subject": "professional_law"}}, "created_at": "2026-08-09T14:20:40.851879+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"causal_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "causal_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "causal_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0}, "validation_errors": [], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:08:29.153004+00:0