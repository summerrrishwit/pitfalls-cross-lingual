{"source_id": "raw_sciq_000226", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 226, "source_question": "What is the name of the process in which the nuclei of uranium atoms are split?", "source_choices": ["critical fission", "atomic fusion", "nuclear fusion", "nuclear fission"], "source_answer": "nuclear fission", "candidate_id": "raw_sciq_000226", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 226, "record": {"question": "What is the name of the process in which the nuclei of uranium atoms are split?", "choices": ["critical fission", "atomic fusion", "nuclear fusion", "nuclear fission"], "answer": "nuclear fission", "source": "sciq"}}, "created_at": "2026-08-09T14:20:32.295930+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"process in which the nuclei of uranium atoms are split\",\n  \"subject_type\": \"process definition\",\n  \"relation_raw\": \"term for definition\",\n  \"answer\": \"nuclear fission\",\n  \"answer_type\": \"scientific term\",\n  \"canonical_fact\": \"The process in which the nuclei of uranium atoms are split is called nuclear fission.\",\n  \"extraction_confidence\": 1.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "process in which the nuclei of uranium atoms are split", "subject_type": "process definition", "relation_raw": "term for definition", "answer": "nuclear fission", "answ