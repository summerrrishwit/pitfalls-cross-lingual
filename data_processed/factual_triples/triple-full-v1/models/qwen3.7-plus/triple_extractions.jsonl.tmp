{"source_id": "raw_mmlu_000161", "source_dataset": "mmlu", "source_subset": "professional_law", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 161, "source_question": "A man needed to have the oil changed on his car. On Friday, he decided to take his car to the local dealership to have the oil changed and asked his neighbor if she would give him a ride home from the dealership. The neighbor said, \"Why pay the high prices a dealership will charge you? I can change the oil in your car for you. If you will agree to pay me $50, I'll change the oil in your car over the weekend. \" The man readily agreed. On Sunday afternoon, the man noticed that his neighbor still had not started working on the car. He asked his neighbor if the car would be ready for him to drive to work Monday morning. The neighbor replied, \"I thought about it and realized $50 is too low a price for the work involved. I don't think I'm going to change the oil in your car. \" The man then said, \"Look, I realize $50 is low for the work involved. If you can change the oil in my car by tomorrow morning, I'll pay you an additional $25. And I won't sue you in small claims court for your failure to perform your promise. \" The neighbor then changed the oil late Sunday afternoon, but the man refused to pay to the neighbor anything more than $50. In a suit by the neighbor to recover the additional $25 promised by the man, the neighbor will", "source_choices": ["win, because she performed her part of the bargain.", "win, because the second contract for $75 superseded the original $50 contract.", "lose, because the $75 contract did not supersede the $50 contract.", "lose, because the neighbor had a pre-existing duty to change the oil in the car for $50."], "source_answer": "lose, because the neighbor had a pre-existing duty to change the oil in the car for $50.", "candidate_id": "raw_mmlu_000161", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 161, "record": {"question": "A man needed to have the oil changed on his car. On Friday, he decided to take his car to the local dealership to have the oil changed and asked his neighbor if she would give him a ride home from the dealership. The neighbor said, \"Why pay the high prices a dealership will charge you? I can change the oil in your car for you. If you will agree to pay me $50, I'll change the oil in your car over the weekend. \" The man readily agreed. On Sunday afternoon, the man noticed that his neighbor still had not started working on the car. He asked his neighbor if the car would be ready for him to drive to work Monday morning. The neighbor replied, \"I thought about it and realized $50 is too low a price for the work involved. I don't think I'm going to change the oil in your car. \" The man then said, \"Look, I realize $50 is low for the work involved. If you can change the oil in my car by tomorrow morning, I'll pay you an additional $25. And I won't sue you in small claims court for your failure to perform your promise. \" The neighbor then changed the oil late Sunday afternoon, but the man refused to pay to the neighbor anything more than $50. In a suit by the neighbor to recover the additional $25 promised by the man, the neighbor will", "choices": ["win, because she performed her part of the bargain.", "win, because the second contract for $75 superseded the original $50 contract.", "lose, because the $75 contract did not supersede the $50 contract.", "lose, because the neighbor had a pre-existing duty to change the oil in the car for $50."], "answer": "lose, because the neighbor had a pre-existing duty to change the oil in the car for $50.", "source": "MMLU", "subject": "professional_law"}}, "created_at": "2026-08-09T07:07:12.283856+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"multi_step_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "multi_step_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "multi_step_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0}, "validation_errors": []}
{"source_id": "raw_sciq_000211", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 211, "source_question": "Ionic compounds have strong electrostatic attractions between oppositely charged ions in this?", "source_choices": ["incorrect array", "normal array", "occasional array", "regular array"], "source_answer": "regular array", "candidate_id": "raw_sciq_000211", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 211, "record": {"question": "Ionic compounds have strong electrostatic attractions between oppositely charged ions in this?", "choices": ["incorrect array", "normal array", "occasional array", "regular array"], "answer": "regular array", "source": "sciq"}}, "created_at": "2026-08-09T07:07:12.859495+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"Ionic compounds\",\n  \"subject_type\": \"chemical compound class\",\n  \"relation_raw\": \"arrangement of oppositely charged ions\",\n  \"answer\": \"regular array\",\n  \"answer_type\": \"structural description\",\n  \"canonical_fact\": \"Ionic compounds have strong electrostatic attractions between oppositely charged ions in a regular array.\",\n  \"extraction_confidence\": 0.95\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "Ionic compounds", "subject_type": "chemical compound class", "relation_raw": "arrangement of oppositely charged ions", "answer": "regular array", "answer_type": "structural des