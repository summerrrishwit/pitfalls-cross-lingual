{"source_id": "raw_ai2_arc_easy_000273", "source_dataset": "ai2_arc_easy", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "source_original_index": 273, "source_question": "What allows a light bulb to give off light?", "source_choices": ["the current flowing through the wire to the light bulb", "the light bulb giving electrical energy to the battery", "the light bulb generating heat energy", "the battery pushing light through the wire"], "source_answer": "the current flowing through the wire to the light bulb", "candidate_id": "raw_ai2_arc_easy_000273", "source_snapshot": {"dataset": "ai2_arc_easy", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "original_index": 273, "record": {"question": "What allows a light bulb to give off light?", "choices": ["the current flowing through the wire to the light bulb", "the light bulb giving electrical energy to the battery", "the light bulb generating heat energy", "the battery pushing light through the wire"], "answer": "the current flowing through the wire to the light bulb", "source": "ai2_arc"}}, "created_at": "2026-08-09T14:21:23.883935+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"causal_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "causal_reasoning", "subject": null, "subject_typ