{"source_id": "raw_ai2_arc_easy_000221", "source_dataset": "ai2_arc_easy", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "source_original_index": 221, "source_question": "A glass of ice water is placed on a table. After 10 minutes, there are drops of water on the outside surface of the glass. Which change in phase caused the drops of water?", "source_choices": ["Liquid water in the air evaporated into a gas.", "Liquid water in the air condensed into a solid.", "Water vapor from the air evaporated into a liquid.", "Water vapor from the air condensed into a liquid."], "source_answer": "Water vapor from the air condensed into a liquid.", "candidate_id": "raw_ai2_arc_easy_000221", "source_snapshot": {"dataset": "ai2_arc_easy", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "original_index": 221, "record": {"question": "A glass of ice water is placed on a table. After 10 minutes, there are drops of water on the outside surface of the glass. Which change in phase caused the drops of water?", "choices": ["Liquid water in the air evaporated into a gas.", "Liquid water in the air condensed into a solid.", "Water vapor from the air evaporated into a liquid.", "Water vapor from the air condensed into a liquid."], "answer": "Water vapor from the air condensed into a liquid.", "source": "ai2_arc"}}, "created_at": "2026-08-09T14:20:26.377177+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"causal_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_f