{"source_id": "raw_sciq_000224", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 224, "source_question": "What is it called when ice changes to liquid water?", "source_choices": ["vaporizing", "boiling", "condensing", "melting"], "source_answer": "melting", "candidate_id": "raw_sciq_000224", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 224, "record": {"question": "What is it called when ice changes to liquid water?", "choices": ["vaporizing", "boiling", "condensing", "melting"], "answer": "melting", "source": "sciq"}}, "created_at": "2026-08-09T14:20:30.278905+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"ice changing to liquid water\",\n  \"subject_type\": \"process\",\n  \"relation_raw\": \"term for\",\n  \"answer\": \"melting\",\n  \"answer_type\": \"scientific term\",\n  \"canonical_fact\": \"The process of ice changing to liquid water is called melting.\",\n  \"extraction_confidence\": 1.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "ice changing to liquid water", "subject_type": "process", "relation_raw": "term for", "answer": "melting", "answer_type": "scientific term", "canonical_fact": "The process of ice changing to liquid water is called melting.", "extraction_confidence": 1.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "extracted", "exclusion_r