{"source_id": "raw_sciq_000200", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 200, "source_question": "Oxygen, carbon dioxide, atp, and nadph are reactants in what process that plants use to produce food?", "source_choices": ["glycolysis", "absorbtion", "chlorophyll", "photosynthesis"], "source_answer": "photosynthesis", "candidate_id": "raw_sciq_000200", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 200, "record": {"question": "Oxygen, carbon dioxide, atp, and nadph are reactants in what process that plants use to produce food?", "choices": ["glycolysis", "absorbtion", "chlorophyll", "photosynthesis"], "answer": "photosynthesis", "source": "sciq"}}, "created_at": "2026-08-09T07:04:41.718570+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"process that plants use to produce food\",\n  \"subject_type\": \"process\",\n  \"relation_raw\": \"name\",\n  \"answer\": \"photosynthesis\",\n  \"answer_type\": \"process\",\n  \"canonical_fact\": \"The process that plants use to produce food is photosynthesis.\",\n  \"extraction_confidence\": 0.95\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "process that plants use to produce food", "subject_type": "process", "relation_raw": "name", "answer": "photosynthesis", "answer_type": "process", "canonical_fact": "The process that plants use to produce food is photosynthesis.", "extraction_confidence": 0.95, "pa