{"source_id": "raw_ai2_arc_easy_001423", "source_dataset": "ai2_arc_easy", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "source_original_index": 1423, "source_question": "Which object in the sky is a satellite of the planet Earth?", "source_choices": ["Sun", "Moon", "Mars", "Saturn"], "source_answer": "Moon", "candidate_id": "raw_ai2_arc_easy_001423", "source_snapshot": {"dataset": "ai2_arc_easy", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "original_index": 1423, "record": {"question": "Which object in the sky is a satellite of the planet Earth?", "choices": ["Sun", "Moon", "Mars", "Saturn"], "answer": "Moon", "source": "ai2_arc"}}, "created_at": "2026-08-09T14:33:40.491979+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": null, "attempt_count": 1, "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': 'Free quota exhausted. To continue accessing the model on a paid basis, please add funds or disable the \"use free tier only\" mode in the management console.', 'type': 'AllocationQuota.FreeTierOnly', 'param': None, 'code': 'AllocationQuota.FreeTierOnly'}, 'id': 'chatcmpl-fece2c4f-2be3-92ca-b018-8efd81bde992', 'request_id': 'fece2c4f-2be3-92ca-b018-8efd81bde992'}"}}, "terminal_status": "extraction_failed", "extraction_status": null, "exclusion_reason": null, "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": null, "parsed_response": null, "validation_errors": ["extraction_request_failed"], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:15:43.636590+00:00", "error": {"category": "perma