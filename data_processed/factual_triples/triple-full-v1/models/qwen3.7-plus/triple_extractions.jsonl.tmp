{"source_id": "raw_ai2_arc_easy_001743", "source_dataset": "ai2_arc_easy", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "source_original_index": 1743, "source_question": "The Earth's equator receives more direct sunlight than the regions to its north and south. This distribution of sunlight accounts directly for which phenomenon?", "source_choices": ["The westward deflection of equatorial winds.", "The movement of rising air currents away from the equator.", "The rotation of storm systems.", "The formation of calm \"eyes\" in the centers of cyclones."], "source_answer": "The movement of rising air currents away from the equator.", "candidate_id": "raw_ai2_arc_easy_001743", "source_snapshot": {"dataset": "ai2_arc_easy", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "original_index": 1743, "record": {"question": "The Earth's equator receives more direct sunlight than the regions to its north and south. This distribution of sunlight accounts directly for which phenomenon?", "choices": ["The westward deflection of equatorial winds.", "The movement of rising air currents away from the equator.", "The rotation of storm systems.", "The formation of calm \"eyes\" in the centers of cyclones."], "answer": "The movement of rising air currents away from the equator.", "source": "ai2_arc"}}, "created_at": "2026-08-09T14:34:43.470212+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": null, "attempt_count": 1, "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': 'Free quota exhausted. To continue accessing the model on a paid basis, please add funds or disable the \"use free tier only\" mode in the management console.', 'type': 'Allo