{"source_id": "raw_ai2_arc_easy_000577", "source_dataset": "ai2_arc_easy", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "source_original_index": 577, "source_question": "During cellular respiration glucose molecules undergo a series of reactions. This process results in the formation of up to 38 molecules of high-energy ATP per each molecule of glucose. Which is the source of the energy stored in these ATP molecules?", "source_choices": ["kinetic energy generated by the chemical reactions", "chemical energy originally stored in the glucose molecule", "electric current created during the destruction of electrons in the glucose", "potential energy from the difference in the concentration gradients of the cell"], "source_answer": "chemical energy originally stored in the glucose molecule", "candidate_id": "raw_ai2_arc_easy_000577", "source_snapshot": {"dataset": "ai2_arc_easy", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "original_index": 577, "record": {"question": "During cellular respiration glucose molecules undergo a series of reactions. This process results in the formation of up to 38 molecules of high-energy ATP per each molecule of glucose. Which is the source of the energy stored in these ATP molecules?", "choices": ["kinetic energy generated by the chemical reactions", "chemical energy originally stored in the glucose molecule", "electric current created during the destruction of electrons in the glucose", "potential energy from the difference in the concentration gradients of the cell"], "answer": "chemical energy originally stored in the glucose molecule", "source": "ai2_arc"}}, "created_at": "2026-08-09T14:24:04.545239+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-0