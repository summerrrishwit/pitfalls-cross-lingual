{"source_id": "raw_sciq_000227", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 227, "source_question": "The strength of a base depends on the concentration of _______ it produces when dissolved in water?", "source_choices": ["combustion ions", "calcium ions", "monoxide ions", "hydroxide ions"], "source_answer": "hydroxide ions", "candidate_id": "raw_sciq_000227", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 227, "record": {"question": "The strength of a base depends on the concentration of _______ it produces when dissolved in water?", "choices": ["combustion ions", "calcium ions", "monoxide ions", "hydroxide ions"], "answer": "hydroxide ions", "source": "sciq"}}, "created_at": "2026-08-09T14:20:33.496994+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"strength of a base\",\n  \"subject_type\": \"chemical property\",\n  \"relation_raw\": \"depends on concentration of\",\n  \"answer\": \"hydroxide ions\",\n  \"answer_type\": \"chemical species\",\n  \"canonical_fact\": \"The strength of a base depends on the concentration of hydroxide ions it produces when dissolved in water.\",\n  \"extraction_confidence\": 0.95\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "strength of a base", "subject_type": "chemical property", "relation_raw": "depends on concentration of", "answer": "hydroxide ions", "answer_type