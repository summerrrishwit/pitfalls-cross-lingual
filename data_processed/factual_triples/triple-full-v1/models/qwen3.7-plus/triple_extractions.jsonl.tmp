{"source_id": "raw_sciq_000229", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 229, "source_question": "Ecological succession refers to the change in the numbers and types of species that live in what groups?", "source_choices": ["movements", "colonies", "biomes", "communities"], "source_answer": "communities", "candidate_id": "raw_sciq_000229", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 229, "record": {"question": "Ecological succession refers to the change in the numbers and types of species that live in what groups?", "choices": ["movements", "colonies", "biomes", "communities"], "answer": "communities", "source": "sciq"}}, "created_at": "2026-08-09T14:20:35.390168+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"Ecological succession\",\n  \"subject_type\": \"concept\",\n  \"relation_raw\": \"occurs in\",\n  \"answer\": \"communities\",\n  \"answer_type\": \"entity\",\n  \"canonical_fact\": \"Ecological succession refers to the change in the numbers and types of species that live in communities.\",\n  \"extraction_confidence\": 0.95\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "Ecological succession", "subject_type": "concept", "relation_raw": "occurs in", "answer": "communities", "answer_type": "entity", "canonical_fact": "Ecological succession refers to the change in the numbers and types of s