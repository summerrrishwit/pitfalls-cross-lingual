{"source_id": "raw_sciq_000221", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 221, "source_question": "What is the electron domain geometry of ammonia?", "source_choices": ["membranes", "atoms", "neurons", "tetrahedral"], "source_answer": "tetrahedral", "candidate_id": "raw_sciq_000221", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 221, "record": {"question": "What is the electron domain geometry of ammonia?", "choices": ["membranes", "atoms", "neurons", "tetrahedral"], "answer": "tetrahedral", "source": "sciq"}}, "created_at": "2026-08-09T14:20:26.665337+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"ammonia\",\n  \"subject_type\": \"chemical compound\",\n  \"relation_raw\": \"electron domain geometry\",\n  \"answer\": \"tetrahedral\",\n  \"answer_type\": \"geometry\",\n  \"canonical_fact\": \"The electron domain geometry of ammonia is tetrahedral.\",\n  \"extraction_confidence\": 1.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "ammonia", "subject_type": "chemical compound", "relation_raw": "electron domain geometry", "answer": "tetrahedral", "answer_type": "geometry", "canonical_fact": "The electron domain geometry of ammonia is tetrahedral.", "extraction_confidence": 1.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "extracted", "exclusion_reason": null