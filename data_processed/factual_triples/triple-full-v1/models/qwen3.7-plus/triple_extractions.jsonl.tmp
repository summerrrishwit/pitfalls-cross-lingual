{"source_id": "raw_sciq_000258", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 258, "source_question": "Yeasts, molds, and mushrooms are all different kinds of what?", "source_choices": ["pollen", "bacteria", "fossil", "fungi"], "source_answer": "fungi", "candidate_id": "raw_sciq_000258", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 258, "record": {"question": "Yeasts, molds, and mushrooms are all different kinds of what?", "choices": ["pollen", "bacteria", "fossil", "fungi"], "answer": "fungi", "source": "sciq"}}, "created_at": "2026-08-09T14:21:06.697096+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"Yeasts, molds, and mushrooms\",\n  \"subject_type\": \"organisms\",\n  \"relation_raw\": \"classification\",\n  \"answer\": \"fungi\",\n  \"answer_type\": \"biological kingdom\",\n  \"canonical_fact\": \"Yeasts, molds, and mushrooms are all different kinds of fungi.\",\n  \"extraction_confidence\": 1.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "Yeasts, molds, and mushrooms", "subject_type": "organisms", "relation_raw": "classification", "answer": "fungi", "answer_type": "biological kingdom", "canonical_fact": "Yeasts, molds, and mushrooms are all different kinds of fungi.", "extraction_confidence": 1.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "extracted", "exclusion_reason": null, "subject": "Yeasts, molds, and mushrooms", "subject_type": "organisms", "relation_raw": "classification", "answer": "fungi", "answer_type": "biological kingdom", "canonical_fact": "Yeasts, molds, and mushrooms are all different kinds of fungi.", "extraction_confidence": 1.0}, "validation_errors": [], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:08:44.196250+00:00", "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': '预扣费额度失败, 用户剩余额度: ¥0.004872, 需要预扣费额度: ¥0.009940 (request id: 202608090708430545965218268d9d6WI8OesO5)', 'type': 'new_api_error', 'param': '', 'code': 'insufficient_user_quota'}}"}, "validation_errors": ["extraction_request_failed"]}]}
{"source_id": "raw_mmlu_000097", "source_dataset": "mmlu", "source_subset": "security_studies", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 97, "source_question": "In what ways can the different relationship between US and European security studies be explained?", "source_choices": ["The different relationship to the concept of security: in Europe the debate has stayed as part of politico-self-reflection of the scholar who 'does security;' whereas in the US, the question of the concept of security is seen at the most a necessary 'define your' terms' operation.", "The different relationship to the exact form of knowledge that is valued. The US is more rationalist, Europe the more reflectivist. In the US security studies debate hypothesis is typically examined as cause-effect relationships, tied into general debates and with measurement of ideational variables.", "In the US major competing explanations emphasized, on the one hand, the US's liberal hegemony, and, on the other hand, the purely power based stability of presumed unipolarity in which balancing becomes impossible.", "All of these options."], "source_answer": "All of these options.", "candidate_id": "raw_mmlu_000097", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 97, "record": {"question": "In what ways can the different relationship between US and European security studies be explained?", "choices": ["The different relationship to the concept of security: in Europe the debate has stayed as part of politico-self-reflection of the scholar who 'does security;' whereas in the US, the question of the concept of security is seen at the most a necessary 'define your' terms' operation.", "The different relationship to the exact form of knowledge that is valued. The US is more rationalist, Europe the more reflectivist. In the US security studies debate hypothesis is typically examined as cause-effect relationships, tied into general debates and with measurement of ideational variables.", "In the US major competing explanations emphasized, on the one hand, the US's liberal hegemony, and, on the other hand, the purely power based stability of presumed unipolarity in which balancing becomes impossible.", "All of these options."], "answer": "All of these options.", "source": "MMLU", "subject": "security_studies"}}, "created_at": "2026-08-09T14:21:07.686010+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"option_dependent\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "option_dependent", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "option_dependent", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0}, "validation_errors": [], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:08:44.742883+00:00", "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': '预扣费额度失败, 用户剩余额度: ¥0.004872, 需要预扣费额度: ¥0.009968 (requ