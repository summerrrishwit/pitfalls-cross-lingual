{"source_id": "raw_mmlu_000294", "source_dataset": "mmlu", "source_subset": "professional_law", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 294, "source_question": "A defendant was convicted of fraud after a jury trial in state court. The conviction was affirmed on direct appeal. The defendant timely moved for postconviction relief under the Sixth Amendment on the ground that his attorney had provided ineffective assistance of counsel. The trial judge, after a hearing, found that the attorney had performed deficiently by failing to raise a proper objection that would have resulted in exclusion of important prosecution evidence. What more, if anything, must the trial court find in order to sustain the defendant's Sixth Amendment claim?", "source_choices": ["Nothing more, because the unjustifiable failure to object to important prosecution evidence is structural error.", "That the attorney was court-appointed and not privately retained.", "That there is a reasonable probability that the trial's outcome would have been different if the attorney had objected.", "That there is clear and convincing evidence that the trial's outcome would have been different if the attorney had objected."], "source_answer": "That there is a reasonable probability that the trial's outcome would have been different if the attorney had objected.", "candidate_id": "raw_mmlu_000294", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 294, "record": {"question": "A defendant was convicted of fraud after a jury trial in state court. The conviction was affirmed on direct appeal. The defendant timely moved for postconviction relief under the Sixth Amendment on the ground that his attorney had provided ineffective assistance of counsel. The trial judge, after a hearing, found that the attorney had performed deficiently by failing to raise a proper objection that would have resulted in exclusion of important prosecution evidence. What more, if anything, must the trial court find in order to sustain the defendant's Sixth Amendment claim?", "choices": ["Nothing more, because the unjustifiable failure to object to important prosecution evidence is structural error.", "That the attorney was court-appointed and not privately retained.", "That there is a reasonable probability that the trial's outcome would have been different if the attorney had objected.", "That there is clear and convincing evidence that the trial's outcome would have been different if the attorney had objected."], "answer": "That there is a reasonable probability that the trial's outcome would have been different if the attorney had objected.", "source": "MMLU", "subject": "professional_law"}}, "created_at": "2026-08-09T14:20:46.026185+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"multi_step_reasoning\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "multi_step_reasoning", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "multi_step_reasoning", "subject": null, "subject_type": null, "relation_raw": nu