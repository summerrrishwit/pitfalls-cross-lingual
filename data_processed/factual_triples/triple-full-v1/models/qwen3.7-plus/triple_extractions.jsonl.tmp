{"source_id": "raw_sciq_000203", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 203, "source_question": "Proteins are polymers of what kind of acids?", "source_choices": ["lipids", "lactic", "acetic", "amino"], "source_answer": "amino", "candidate_id": "raw_sciq_000203", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 203, "record": {"question": "Proteins are polymers of what kind of acids?", "choices": ["lipids", "lactic", "acetic", "amino"], "answer": "amino", "source": "sciq"}}, "created_at": "2026-08-09T07:05:18.987458+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"Proteins\",\n  \"subject_type\": \"biological molecule\",\n  \"relation_raw\": \"polymers of ... acids\",\n  \"answer\": \"amino\",\n  \"answer_type\": \"chemical modifier\",\n  \"canonical_fact\": \"Proteins are polymers of amino acids.\",\n  \"extraction_confidence\": 0.95\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "Proteins", "subject_type": "biological molecule", "relation_raw": "polymers of ... acids", "answer": "amino", "answer_type": "chemical modifier", "canonical_fact": "Proteins are polymers of amino acids.", "extraction_confidence": 0.95, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "extracted", "exclusion_reason": null, "subject": "Proteins", "subject_type": "biological molecule", "relation_raw": "polymers of ... acids", "a