{"source_id": "raw_sciq_000267", "source_dataset": "sciq", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "source_original_index": 267, "source_question": "What do you call nutrients that your body needs in fairly large amounts?", "source_choices": ["B-complex", "super foods", "antioxidants", "macronutrients"], "source_answer": "macronutrients", "candidate_id": "raw_sciq_000267", "source_snapshot": {"dataset": "sciq", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/sciq.json", "original_index": 267, "record": {"question": "What do you call nutrients that your body needs in fairly large amounts?", "choices": ["B-complex", "super foods", "antioxidants", "macronutrients"], "answer": "macronutrients", "source": "sciq"}}, "created_at": "2026-08-09T14:21:17.547185+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"extracted\",\n  \"exclusion_reason\": null,\n  \"subject\": \"nutrients that your body needs in fairly large amounts\",\n  \"subject_type\": \"concept\",\n  \"relation_raw\": \"term for definition\",\n  \"answer\": \"macronutrients\",\n  \"answer_type\": \"entity\",\n  \"canonical_fact\": \"Nutrients that your body needs in fairly large amounts are called macronutrients.\",\n  \"extraction_confidence\": 1.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "extracted", "exclusion_reason": null, "subject": "nutrients that your body needs in fairly large amounts", "subject_type": "concept", "relation_raw": "term for definition", "answer": "macronutrients", "answer_type": "entity", "canonical_fact": "Nutrients that your body needs in fairly large amounts are called macronutrients.", "extraction_confidence": 1.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "extracted", "exclusion_reason": null, "subject": "nutrients that your body needs in fairly large amounts", "subject_type": "concept", "relation_raw": "term for definition", "answer": "macronutrients", "answer_type": "entity", "canonical_fact": "Nutrients that your body needs in fairly large amounts are called macronutrients.", "extraction_confidence": 1.0}, "validation_errors": [], "retry_history": [{"terminal_status": "extraction_failed", "created_at": "2026-08-09T07:08:48.816652+00:00", "error": {"category": "permanent_failure", "message": "Error code: 403 - {'error': {'message': '预扣费额度失败, 用户剩余额度: ¥0.004872, 需要预扣费额度: ¥0.009940 (request id: 202608090708480848841838268d9d6YVLGqAno)', 'type': 'new_api_error', 'param': '', 'code': 'insufficient_user_quota'}}"}, "validation_errors": ["extraction_request_failed"]}]}
{"source_id": "raw_mmlu_000169", "source_dataset": "mmlu", "source_subset": "security_studies", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 169, "source_question": "What is the relationship between Westphalian sovereignty and humanitarian intervention?", "source_choices": ["In its advocacy of global political institutions, the Treaty of Westphalia defined state sovereignty as being subjective to the behaviour of the political or ruling elite in that state, prioritizing human welfare over arbitrary values of sovereignty and thus legitimising humanitarian intervention where necessary.", "Theories of Westphalian sovereignty decree that principles of non-intervention are paramount to achieving security; this has been extended into the contemporary global security environment in which international bodies such as the UN condemn humanitarian intervention, regarding it as detrimental to state-centric security.", "State sovereignty and principles of non-interference that underpin the Westphalian approach can be disregarded, provided that there is a consensus amongst international actors that human life within the state is at risk, and where that risk is from the actions of the state itself.", "The international society is governed by norms of Westphalian sovereignty that advocate non-intervention and the respect of state sovereignty as a means of achieving security. These norms are enshrined in the Charter of the United Nations, which bans the use of force between states except in self-defence or when authorized by the UN."], "source_answer": "The international society is governed by norms of Westphalian sovereignty that advocate non-intervention and the respect of state sovereignty as a means of achieving security. These norms are enshrined in the Charter of the United Nations, which bans the use of force between states except in self-defence or when authorized by the UN.", "candidate_id": "raw_mmlu_000169", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 169, "record": {"question": "What is the relationship between Westphalian sovereignty and humanitarian intervention?", "choices": ["In its advocacy of global political institutions, the Treaty of Westphalia defined state sovereignty as being subjective to the behaviour of the political or ruling elite in that state, prioritizing human welfare over arbitrary values of sovereignty and thus legitimising humanitarian intervention where necessary.", "Theories of Westphalian sovereignty decree that principles of non-intervention are paramount to achieving security; this has been extended into the contemporary global security environment in which international bodies such as the UN condemn humanitarian intervention, regarding it as detrimental to state-centric security.", "State sovereignty and principles of non-interference that underpin the Westphalian approach can be disregarded, provided that there is a consensus amongst international actors that human life within the state is at risk, and where that risk is from the actions of the state itself.", "The international society is governed by norms of Westphalian sovereignty that advocate non-intervention and the respect of state sovereignty as a means of achieving security. These norms are enshrined in the Charter of the United Nations, which bans the use of force between states except in self-defence or when authorized by the UN."], "answer": "The international society is governed by norms of Westphalian sovereignty that advocate non-intervention and the respect of state sovereignty as a means of achieving security. These norms are enshrined in the Charter of the United Nations, which bans the use of force between states except in self-defence or when authorized by the UN.", "source": "MMLU", "subject": "security_studies"}}, "created_at"