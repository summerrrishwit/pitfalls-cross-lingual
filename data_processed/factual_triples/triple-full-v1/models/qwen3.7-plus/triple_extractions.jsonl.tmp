{"source_id": "raw_ai2_arc_easy_000484", "source_dataset": "ai2_arc_easy", "source_subset": null, "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "source_original_index": 484, "source_question": "A scientist wants to track contaminant movement in the Gulf Stream. The Gulf Stream is a warm water current in the North Atlantic Ocean and is part of the North Atlantic gyre. The gyre is influenced by the Coriolis effect. To follow the contaminant after it exits the Gulf Stream, the scientist needs to know characteristics of the North Atlantic gyre. Which of these best describes a movement of the North Atlantic gyre the scientist needs to know?", "source_choices": ["linear movement due west", "linear movement due south", "clockwise movement", "counterclockwise movement"], "source_answer": "clockwise movement", "candidate_id": "raw_ai2_arc_easy_000484", "source_snapshot": {"dataset": "ai2_arc_easy", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/ai2_arc_easy.json", "original_index": 484, "record": {"question": "A scientist wants to track contaminant movement in the Gulf Stream. The Gulf Stream is a warm water current in the North Atlantic Ocean and is part of the North Atlantic gyre. The gyre is influenced by the Coriolis effect. To follow the contaminant after it exits the Gulf Stream, the scientist needs to know characteristics of the North Atlantic gyre. Which of these best describes a movement of the North Atlantic gyre the scientist needs to know?", "choices": ["linear movement due west", "linear movement due south", "clockwise movement", "counterclockwise movement"], "answer": "clockwise movement", "source": "ai2_arc"}}, "created_at": "2026-08-10T03:12:11.183461+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-plus-2026-05-26", "raw_respons