{"source_id": "raw_mmlu_000123", "source_dataset": "mmlu", "source_subset": "security_studies", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "source_original_index": 123, "source_question": "What external strategies do elites employ?", "source_choices": ["An increasingly popular means of bolstering regime security has been the expulsion of foreign workers and non-ethnic nationals and restricting borders to refugees and migrants.", "Weak states seek to avoid alliances with powerful states because alliances and assistance frequently are conditional on democratization and risk penalties if they are not met.", "An increasingly prevalent strategy among weak states has been the employment of private military or security companies and foreign mercenaries as force multipliers to secure the weak state from internal threats.", "Weak states may sometimes militarily engage in action to bolster their regional position and to mobilize internal support against the construction of an imagined external threat. This frequently coincides with economic or social crises as a policy of distraction."], "source_answer": "An increasingly prevalent strategy among weak states has been the employment of private military or security companies and foreign mercenaries as force multipliers to secure the weak state from internal threats.", "candidate_id": "raw_mmlu_000123", "source_snapshot": {"dataset": "mmlu", "source_path": "/Users/qiqing/learn_resource/mutil-language/pitfalls-cross-lingual/data/source/mmlu.json", "original_index": 123, "record": {"question": "What external strategies do elites employ?", "choices": ["An increasingly popular means of bolstering regime security has been the expulsion of foreign workers and non-ethnic nationals and restricting borders to refugees and migrants.", "Weak states seek to avoid alliances with powerful states because alliances and assistance frequently are conditional on democratization and risk penalties if they are not met.", "An increasingly prevalent strategy among weak states has been the employment of private military or security companies and foreign mercenaries as force multipliers to secure the weak state from internal threats.", "Weak states may sometimes militarily engage in action to bolster their regional position and to mobilize internal support against the construction of an imagined external threat. This frequently coincides with economic or social crises as a policy of distraction."], "answer": "An increasingly prevalent strategy among weak states has been the employment of private military or security companies and foreign mercenaries as force multipliers to secure the weak state from internal threats.", "source": "MMLU", "subject": "security_studies"}}, "created_at": "2026-08-09T14:21:10.879779+00:00", "extraction": {"model": "qwen3.7-plus", "role": "TRIPLE_LABEL_MODEL", "prompt_version": "atomic-factual-triple-v6", "temperature": 0.0, "api_model": "qwen3.7-flash-2026-07-15", "raw_response": "{\n  \"schema_version\": \"atomic-factual-triple-v6\",\n  \"extraction_status\": \"not_extractable\",\n  \"exclusion_reason\": \"ambiguous_subject\",\n  \"subject\": null,\n  \"subject_type\": null,\n  \"relation_raw\": null,\n  \"answer\": null,\n  \"answer_type\": null,\n  \"canonical_fact\": null,\n  \"extraction_confidence\": 0.0\n}", "attempt_count": 1, "error": null, "program_adjustments": []}, "terminal_status": "completed", "extraction_status": "not_extractable", "exclusion_reason": "ambiguous_subject", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence": 0.0, "parsed_response": {"schema_version": "atomic-factual-triple-v6", "extraction_status": "not_extractable", "exclusion_reason": "ambiguous_subject", "subject": null, "subject_type": null, "relation_raw": null, "answer": null, "answer_type": null, "canonical_fact": null, "extraction_confidence":